{
    "name": "itmosoft/laravel-seo",
    "description": "SEO metadata, canonical URLs, social sharing tags, and JSON-LD structured data for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ItmoSoft\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItmoSoft\\Seo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ItmoSoft\\Seo\\SeoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}